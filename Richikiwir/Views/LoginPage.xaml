<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Richikiwir.Models"
             x:Class="Richikiwir.Views.LoginPage"
             BackgroundColor="{StaticResource AppBackground}"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Spacing="0">
            <!-- Header Banner Edukasi / Sekolah -->
            <Grid HeightRequest="250" BackgroundColor="{StaticResource Primary}">
                <!-- Background Accent Elements -->
                <BoxView Color="#2563EB" Opacity="0.3" CornerRadius="120" WidthRequest="240" HeightRequest="240"
                         HorizontalOptions="End" VerticalOptions="Start" TranslationX="60" TranslationY="-60" />
                <BoxView Color="#0D9488" Opacity="0.25" CornerRadius="90" WidthRequest="180" HeightRequest="180"
                         HorizontalOptions="Start" VerticalOptions="End" TranslationX="-40" TranslationY="40" />

                <!-- Logo & School Branding -->
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="6" Padding="20,10">
                    <!-- School Emblem Badge -->
                    <Border StrokeShape="RoundRectangle 24" 
                            Stroke="White" 
                            StrokeThickness="2"
                            WidthRequest="80" 
                            HeightRequest="80" 
                            BackgroundColor="White"
                            Padding="4"
                            HorizontalOptions="Center">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,4" Radius="8" Opacity="0.25" />
                        </Border.Shadow>
                        <Image Source="logo_smkn5.png" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>

                    <Label Text="SMK NEGERI 5 KABUPATEN TANGERANG" 
                           FontSize="11" 
                           FontAttributes="Bold" 
                           TextColor="#93C5FD" 
                           HorizontalTextAlignment="Center" 
                           CharacterSpacing="1.2" />
                    
                    <Label Text="SIM-PKL PRESENSI" 
                           FontSize="22" 
                           FontAttributes="Bold" 
                           TextColor="White" 
                           HorizontalTextAlignment="Center" />

                    <Label Text="Sistem Monitoring PKL &amp; Presensi Realtime" 
                           FontSize="12" 
                           TextColor="#CBD5E1" 
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>

            <!-- Card Form Login Elegan -->
            <Border Margin="20,-30,20,20" 
                    StrokeShape="RoundRectangle 20" 
                    Stroke="{StaticResource BorderLight}" 
                    StrokeThickness="1" 
                    BackgroundColor="White" 
                    Padding="24">
                <Border.Shadow>
                    <Shadow Brush="#94A3B8" Offset="0,8" Radius="16" Opacity="0.15" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="16">
                    
                    <Label Text="Masuk ke Akun Anda" 
                           FontSize="18" 
                           FontAttributes="Bold" 
                           TextColor="{StaticResource PrimaryDark}" />
                    <Label Text="Silakan pilih peran dan masukkan kredensial resmi sekolah/industri." 
                           FontSize="12" 
                           TextColor="{StaticResource Gray500}" 
                           Margin="0,-10,0,4" />

                    <!-- Selector 5 Role PKL -->
                    <Label Text="Pilih Peran Pengguna:" 
                           FontSize="12" 
                           FontAttributes="Bold" 
                           TextColor="{StaticResource Gray700}" />
                    
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="8">
                            <Button x:Name="BtnRoleSiswa" Text="🎓 Siswa" FontSize="11" FontAttributes="Bold"
                                    HeightRequest="36" CornerRadius="18" Padding="12,0"
                                    Clicked="OnRoleSelectedClicked" CommandParameter="Siswa" />
                            <Button x:Name="BtnRoleIndustri" Text="🏢 Pembimbing Industri" FontSize="11" FontAttributes="Bold"
                                    HeightRequest="36" CornerRadius="18" Padding="12,0"
                                    Clicked="OnRoleSelectedClicked" CommandParameter="PembimbingIndustri" />
                            <Button x:Name="BtnRoleSekolah" Text="🏫 Guru Sekolah" FontSize="11" FontAttributes="Bold"
                                    HeightRequest="36" CornerRadius="18" Padding="12,0"
                                    Clicked="OnRoleSelectedClicked" CommandParameter="PembimbingSekolah" />
                            <Button x:Name="BtnRoleAdmin" Text="⚙️ Admin PKL" FontSize="11" FontAttributes="Bold"
                                    HeightRequest="36" CornerRadius="18" Padding="12,0"
                                    Clicked="OnRoleSelectedClicked" CommandParameter="Admin" />
                        </HorizontalStackLayout>
                    </ScrollView>

                    <!-- Role Description Pill -->
                    <Border StrokeShape="RoundRectangle 10" BackgroundColor="#EFF6FF" Stroke="#BFDBFE" Padding="12,8">
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Label Text="ℹ️" FontSize="14" VerticalOptions="Center" />
                            <Label x:Name="LblRoleInfo" 
                                   Text="Masuk sebagai Siswa PKL: Mengakses absensi live GPS, selfie kehadiran, &amp; jurnal harian." 
                                   FontSize="11" 
                                   TextColor="#1E40AF" 
                                   LineBreakMode="WordWrap" />
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Input NISN / NIP -->
                    <VerticalStackLayout Spacing="6">
                        <Label x:Name="LblIdentifier" Text="NISN (Nomor Induk Siswa Nasional):" 
                               FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Gray700}" />
                        <Border StrokeShape="RoundRectangle 12" Stroke="{StaticResource Gray300}" StrokeThickness="1" BackgroundColor="#F8FAFC" Padding="12,4">
                            <Grid ColumnDefinitions="30,*">
                                <Label Text="🆔" FontSize="14" VerticalOptions="Center" HorizontalOptions="Center" />
                                <Entry x:Name="TxtIdentifier" Grid.Column="1" 
                                       Placeholder="Masukkan NISN atau Email" 
                                       FontSize="13" 
                                       TextColor="{StaticResource Gray900}" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Input Password -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Kata Sandi:" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Gray700}" />
                        <Border StrokeShape="RoundRectangle 12" Stroke="{StaticResource Gray300}" StrokeThickness="1" BackgroundColor="#F8FAFC" Padding="12,4">
                            <Grid ColumnDefinitions="30,*,40">
                                <Label Text="🔒" FontSize="14" VerticalOptions="Center" HorizontalOptions="Center" />
                                <Entry x:Name="TxtPassword" Grid.Column="1" 
                                       Placeholder="Masukkan kata sandi" 
                                       IsPassword="True" 
                                       FontSize="13" 
                                       TextColor="{StaticResource Gray900}" />
                                <Button Grid.Column="2" 
                                        Text="👁️" 
                                        FontSize="14"
                                        Clicked="OnTogglePasswordClicked" 
                                        BackgroundColor="Transparent" 
                                        TextColor="#64748B" 
                                        Padding="0" 
                                        WidthRequest="36" 
                                        HeightRequest="36" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Remember & Forgot Password -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,-4,0,4">
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <CheckBox IsChecked="True" Color="{StaticResource Primary}" />
                            <Label Text="Ingat Sesi Saya" FontSize="11" TextColor="{StaticResource Gray600}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label Grid.Column="1" Text="Lupa Sandi?" FontSize="11" FontAttributes="Bold" 
                               TextColor="{StaticResource PrimaryLight}" VerticalOptions="Center" TextDecorations="Underline">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnForgotPasswordTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <!-- Tombol Masuk Utama -->
                    <Button x:Name="BtnLogin" 
                            Text="Masuk ke Sistem PKL" 
                            FontAttributes="Bold" 
                            FontSize="14" 
                            BackgroundColor="{StaticResource Primary}" 
                            TextColor="White" 
                            HeightRequest="48" 
                            CornerRadius="12"
                            Clicked="OnLoginClicked" />

                </VerticalStackLayout>
            </Border>

            <!-- Copyright Footer -->
            <Label Text="© 2026 SMK Negeri 1 Rekayasa &amp; Teknologi • BKK PKL Terpadu" 
                   FontSize="11" 
                   TextColor="{StaticResource Gray400}" 
                   HorizontalOptions="Center" 
                   Margin="0,0,0,24" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
