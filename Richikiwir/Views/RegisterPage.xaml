<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Richikiwir.Views.RegisterPage"
             BackgroundColor="{StaticResource AppBackground}"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Spacing="0">
            <!-- Header Bar -->
            <Grid HeightRequest="150" BackgroundColor="{StaticResource Primary}" Padding="20,10,20,0">
                <BoxView Color="#3B82F6" Opacity="0.25" CornerRadius="80" WidthRequest="160" HeightRequest="160"
                         HorizontalOptions="End" VerticalOptions="Start" TranslationX="40" TranslationY="-30" />
                
                <Grid ColumnDefinitions="40,*,56" RowDefinitions="Auto,Auto" VerticalOptions="Center">
                    <Border Grid.RowSpan="2" StrokeShape="RoundRectangle 20" BackgroundColor="#2563EB" 
                            WidthRequest="40" HeightRequest="40" HorizontalOptions="Start">
                        <Label Text="←" TextColor="White" FontSize="20" FontAttributes="Bold"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackTapped" />
                        </Border.GestureRecognizers>
                    </Border>

                    <Label Grid.Column="1" Text="SMK NEGERI 5 KAB. TANGERANG" FontSize="11" FontAttributes="Bold" 
                           TextColor="#93C5FD" CharacterSpacing="1.2" Margin="10,0,0,0" />
                    <Label Grid.Row="1" Grid.Column="1" Text="Registrasi Akun Baru" FontSize="19" FontAttributes="Bold" 
                           TextColor="White" Margin="10,0,0,0" />

                    <!-- School Logo Badge -->
                    <Border Grid.Column="2" Grid.RowSpan="2"
                            StrokeShape="RoundRectangle 18"
                            Stroke="White" StrokeThickness="1.5"
                            WidthRequest="52" HeightRequest="52"
                            BackgroundColor="White"
                            Padding="3"
                            HorizontalOptions="End" VerticalOptions="Center">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.25" />
                        </Border.Shadow>
                        <Image Source="logo_smkn5.png" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>
            </Grid>

            <!-- Card Registrasi -->
            <Border Margin="20,-24,20,30" 
                    StrokeShape="RoundRectangle 20" 
                    Stroke="{StaticResource BorderLight}" 
                    StrokeThickness="1" 
                    BackgroundColor="White" 
                    Padding="22">
                <Border.Shadow>
                    <Shadow Brush="#94A3B8" Offset="0,8" Radius="16" Opacity="0.15" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="14">
                    
                    <Label Text="Identitas Pengguna" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource PrimaryDark}" />
                    <Label Text="Lengkapi data diri sesuai data Dapodik Sekolah atau Kemitraan DU/DI." 
                           FontSize="12" TextColor="{StaticResource Gray500}" Margin="0,-10,0,2" />

                    <!-- Pilih Role -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Pilih Peran Anda di Program PKL:" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Gray700}" />
                        <Border StrokeShape="RoundRectangle 12" Stroke="{StaticResource Gray300}" StrokeThickness="1" BackgroundColor="#F8FAFC" Padding="12,0">
                            <Picker x:Name="PkrRole" SelectedIndexChanged="OnRolePickerChanged" TextColor="{StaticResource Gray900}">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>Siswa PKL (Intern)</x:String>
                                        <x:String>Pembimbing Industri (Mentor DU/DI)</x:String>
                                        <x:String>Pembimbing Sekolah (Guru)</x:String>
                                        <x:String>Tim Monitoring Lapangan</x:String>
                                        <x:String>Administrator Sistem PKL</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Nama Lengkap -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Nama Lengkap (Beserta Gelar jika ada):" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Gray700}" />
                        <Border StrokeShape="RoundRectangle 12" Stroke="{StaticResource Gray300}" StrokeThickness="1" BackgroundColor="#F8FAFC" Padding="12,4">
                            <Entry x:Name="TxtFullName" Placeholder="Contoh: Muhammad Aditya Pratama" FontSize="13" TextColor="{StaticResource Gray900}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- NISN / NIP -->
                    <VerticalStackLayout Spacing="6">
                        <Label x:Name="LblRegIdentifier" Text="NISN (10 Digit Angka):" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Gray700}" />
                        <Border StrokeShape="RoundRectangle 12" Stroke="{StaticResource Gray300}" StrokeThickness="1" BackgroundColor="#F8FAFC" Padding="12,4">
                            <Entry x:Name="TxtRegIdentifier" Placeholder="Contoh: 0068912345" Keyboard="Numeric" FontSize="13" TextColor="{StaticResource Gray900}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Asal Sekolah -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Asal Sekolah:" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Gray700}" />
                        <Border StrokeShape="RoundRectangle 12" Stroke="{StaticResource Gray300}" StrokeThickness="1" BackgroundColor="#F8FAFC" Padding="12,4">
                            <Entry x:Name="TxtSchool" Text="SMK Negeri 5 Kabupaten Tangerang" Placeholder="SMK Negeri 5 Kabupaten Tangerang" FontSize="13" TextColor="{StaticResource Gray900}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- DU/DI Mitra -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Perusahaan Tempat PKL (DU/DI):" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Gray700}" />
                        <Border StrokeShape="RoundRectangle 12" Stroke="{StaticResource Gray300}" StrokeThickness="1" BackgroundColor="#F8FAFC" Padding="12,4">
                            <Entry x:Name="TxtCompany" Placeholder="Contoh: PT Solusi Digital Nusantara" FontSize="13" TextColor="{StaticResource Gray900}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Jurusan / Bidang Keahlian -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Kompetensi Keahlian / Jurusan:" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Gray700}" />
                        <Border StrokeShape="RoundRectangle 12" Stroke="{StaticResource Gray300}" StrokeThickness="1" BackgroundColor="#F8FAFC" Padding="12,4">
                            <Entry x:Name="TxtMajor" Placeholder="Contoh: Rekayasa Perangkat Lunak (RPL)" FontSize="13" TextColor="{StaticResource Gray900}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Email & No HP -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Email:" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Gray700}" />
                            <Border StrokeShape="RoundRectangle 12" Stroke="{StaticResource Gray300}" StrokeThickness="1" BackgroundColor="#F8FAFC" Padding="10,4">
                                <Entry x:Name="TxtEmail" Placeholder="nama@sekolah.sch.id" Keyboard="Email" FontSize="12" TextColor="{StaticResource Gray900}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="WhatsApp:" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Gray700}" />
                            <Border StrokeShape="RoundRectangle 12" Stroke="{StaticResource Gray300}" StrokeThickness="1" BackgroundColor="#F8FAFC" Padding="10,4">
                                <Entry x:Name="TxtPhone" Placeholder="0812-xxxx-xxxx" Keyboard="Telephone" FontSize="12" TextColor="{StaticResource Gray900}" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Kata Sandi -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Buat Kata Sandi:" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Gray700}" />
                        <Border StrokeShape="RoundRectangle 12" Stroke="{StaticResource Gray300}" StrokeThickness="1" BackgroundColor="#F8FAFC" Padding="12,4">
                            <Entry x:Name="TxtRegPassword" Placeholder="Minimal 6 karakter" IsPassword="True" FontSize="13" TextColor="{StaticResource Gray900}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- SOP Checkbox -->
                    <Grid ColumnDefinitions="30,*" Margin="0,4,0,4">
                        <CheckBox x:Name="ChkTerms" Color="{StaticResource Primary}" IsChecked="True" VerticalOptions="Start" />
                        <Label Grid.Column="1" 
                               Text="Saya menyatakan bahwa data di atas valid serta bersedia mematuhi Tata Tertib PKL &amp; SOP Presensi Berbasis GPS Geolocation." 
                               FontSize="11" TextColor="{StaticResource Gray600}" VerticalOptions="Center" />
                    </Grid>

                    <!-- Tombol Registrasi -->
                    <Button Text="Daftar &amp; Aktivasi Akun PKL" 
                            FontAttributes="Bold" 
                            FontSize="14" 
                            BackgroundColor="{StaticResource Primary}" 
                            TextColor="White" 
                            HeightRequest="48" 
                            CornerRadius="12"
                            Clicked="OnSubmitRegisterClicked" />

                    <!-- Link Login -->
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="4" Margin="0,6,0,0">
                        <Label Text="Sudah memiliki akun terdaftar?" FontSize="12" TextColor="{StaticResource Gray600}" />
                        <Label Text="Masuk ke Akun" FontSize="12" FontAttributes="Bold" 
                               TextColor="{StaticResource PrimaryLight}" TextDecorations="Underline">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBackTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
