<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Richikiwir.Models"
             x:Class="Richikiwir.Views.HomePage"
             BackgroundColor="{StaticResource AppBackground}"
             Title="Home">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="18">

            <!-- Profile & School Header Card -->
            <Border StrokeShape="RoundRectangle 20" BackgroundColor="{StaticResource Primary}" StrokeThickness="0" Padding="18">
                <Border.Shadow>
                    <Shadow Brush="#1E3A8A" Offset="0,4" Radius="12" Opacity="0.25" />
                </Border.Shadow>
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <VerticalStackLayout Spacing="4">
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Image Source="logo_smkn5.png" WidthRequest="20" HeightRequest="20" Aspect="AspectFit" VerticalOptions="Center" />
                            <Label x:Name="LblSchoolHeader" Text="SMK NEGERI 5 KABUPATEN TANGERANG" 
                                   FontSize="11" FontAttributes="Bold" TextColor="#93C5FD" CharacterSpacing="1" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label x:Name="LblGreeting" Text="Selamat Datang," FontSize="13" TextColor="#CBD5E1" />
                        <Label x:Name="LblUserName" Text="Rizky Ramadhan" FontSize="19" FontAttributes="Bold" TextColor="White" />
                        <Label x:Name="LblUserSubtitle" Text="XII RPL 1 • NISN: 0067821944" FontSize="11" TextColor="#E2E8F0" />
                    </VerticalStackLayout>

                    <!-- Role Badge & Avatar -->
                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center" Spacing="6">
                        <Border x:Name="BrdAvatar" StrokeShape="RoundRectangle 25" BackgroundColor="#2563EB" 
                                Stroke="White" StrokeThickness="2" WidthRequest="50" HeightRequest="50">
                            <Label x:Name="LblAvatarInitials" Text="RR" TextColor="White" FontSize="16" FontAttributes="Bold"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Border x:Name="BrdRoleBadge" StrokeShape="RoundRectangle 10" BackgroundColor="#3B82F6" Padding="8,3">
                            <Label x:Name="LblRoleBadge" Text="Siswa PKL" FontSize="10" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>
            </Border>



            <!-- ========================================== -->
            <!-- VIEW 1: ROLE SISWA (Dashboard Siswa PKL)    -->
            <!-- ========================================== -->
            <VerticalStackLayout x:Name="LayoutSiswaView" Spacing="16" IsVisible="True">
                
                <!-- Card Utama: Presensi Realtime Quick Action -->
                <Border StrokeShape="RoundRectangle 16" Stroke="{StaticResource BorderLight}" StrokeThickness="1" 
                        BackgroundColor="White" Padding="16">
                    <Border.Shadow>
                        <Shadow Brush="#94A3B8" Offset="0,4" Radius="8" Opacity="0.1" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="PRESENSI HARI INI" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Gray500}" CharacterSpacing="1" />
                                <Label x:Name="LblSiswaCompany" Text="PT Solusi Digital Nusantara" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource PrimaryDark}" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1" StrokeShape="RoundRectangle 10" BackgroundColor="#DCFCE7" Padding="8,4" VerticalOptions="Center">
                                <Label Text="Radius PKL: 24m OK" FontSize="10" FontAttributes="Bold" TextColor="#15803D" />
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <!-- Card Jam Masuk -->
                            <Border StrokeShape="RoundRectangle 12" BackgroundColor="#EFF6FF" Stroke="#BFDBFE" Padding="12">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Masuk (Check-In)" FontSize="10" TextColor="#1D4ED8" FontAttributes="Bold" />
                                    <Label x:Name="LblSiswaCheckInTime" Text="Belum Absen" FontSize="15" FontAttributes="Bold" TextColor="#1E3A8A" />
                                    <Label x:Name="LblSiswaCheckInSub" Text="Silakan lakukan presensi" FontSize="9" TextColor="#2563EB" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Card Jam Pulang -->
                            <Border StrokeShape="RoundRectangle 12" BackgroundColor="#F1F5F9" Stroke="#E2E8F0" Padding="12">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Pulang (Check-Out)" FontSize="10" TextColor="{StaticResource Gray600}" FontAttributes="Bold" />
                                    <Label x:Name="LblSiswaCheckOutTime" Text="Belum Absen" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Gray700}" />
                                    <Label x:Name="LblSiswaCheckOutSub" Text="Tersedia pkl 17:00" FontSize="9" TextColor="{StaticResource Gray500}" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <!-- Tombol Buka Halaman Presensi GPS & Foto -->
                        <Button Text="📍 Presensi Sekarang (Lokasi Realtime &amp; Foto)" 
                                FontAttributes="Bold" FontSize="13" 
                                BackgroundColor="{StaticResource Primary}" TextColor="White" 
                                HeightRequest="46" CornerRadius="12"
                                Clicked="OnOpenAttendancePageClicked" />
                    </VerticalStackLayout>
                </Border>


                <!-- Jurnal Harian Quick Card -->
                <Border StrokeShape="RoundRectangle 16" BackgroundColor="#F0FDF4" Stroke="#BBF7D0" Padding="14">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                        <Label Text="📖" FontSize="26" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Jurnal Harian PKL (Logbook)" FontSize="13" FontAttributes="Bold" TextColor="#166534" />
                            <Label Text="Catat aktivitas dan kompetensi yang dipelajari hari ini." FontSize="11" TextColor="#15803D" />
                        </VerticalStackLayout>
                        <Button Grid.Column="2" Text="Tulis" FontSize="11" FontAttributes="Bold" BackgroundColor="{StaticResource Success}" TextColor="White" 
                                HeightRequest="32" Padding="12,0" CornerRadius="8" Clicked="OnWriteLogbookClicked" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- ======================================================== -->
            <!-- VIEW 2: ROLE PEMBIMBING INDUSTRI (Mentor DU/DI)           -->
            <!-- ======================================================== -->
            <VerticalStackLayout x:Name="LayoutIndustriView" Spacing="16" IsVisible="False">
                <!-- Alert Verifikasi Absensi -->
                <Border StrokeShape="RoundRectangle 16" BackgroundColor="#FEF3C7" Stroke="#FCD34D" Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label Text="⚠️" FontSize="16" VerticalOptions="Center" />
                                <Label Text="Verifikasi Presensi Realtime" FontSize="13" FontAttributes="Bold" TextColor="#92400E" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Border Grid.Column="1" StrokeShape="RoundRectangle 10" BackgroundColor="#D97706" Padding="6,2">
                                <Label Text="1 Menunggu" FontSize="10" FontAttributes="Bold" TextColor="White" />
                            </Border>
                        </Grid>
                        <Label Text="Siswa Rizky Ramadhan melakukan Check-In (07:42 WIB) dalam radius 24.5m dengan foto selfie terlampir." 
                               FontSize="11" TextColor="#78350F" />
                        
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Text="✓ Setujui Presensi" FontSize="11" FontAttributes="Bold" 
                                    BackgroundColor="{StaticResource Success}" TextColor="White" HeightRequest="36" CornerRadius="8"
                                    Clicked="OnApproveAttendanceClicked" />
                            <Button Grid.Column="1" Text="Tinjau Lokasi &amp; Foto" FontSize="11" FontAttributes="Bold" 
                                    BackgroundColor="#F1F5F9" TextColor="{StaticResource Gray800}" HeightRequest="36" CornerRadius="8"
                                    Clicked="OnReviewAttendanceDetailsClicked" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Daftar Siswa Magang di Perusahaan -->
                <Border StrokeShape="RoundRectangle 16" Stroke="{StaticResource BorderLight}" StrokeThickness="1" 
                        BackgroundColor="White" Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Siswa PKL di PT Solusi Digital" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource PrimaryDark}" />
                            <Label Grid.Column="1" Text="2 Siswa Aktif" FontSize="11" TextColor="{StaticResource PrimaryLight}" FontAttributes="Bold" />
                        </Grid>

                        <!-- Item Siswa 1 -->
                        <Border StrokeShape="RoundRectangle 12" BackgroundColor="#F8FAFC" Stroke="{StaticResource BorderLight}" Padding="12">
                            <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                <Border StrokeShape="RoundRectangle 20" BackgroundColor="#2563EB" WidthRequest="40" HeightRequest="40">
                                    <Label Text="RR" TextColor="White" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Rizky Ramadhan" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Gray900}" />
                                    <Label Text="XII RPL 1 • Hadir (07:42 WIB)" FontSize="11" TextColor="{StaticResource Success}" />
                                    <Label Text="Jurnal Hari Ini: Terkirim ✓" FontSize="10" TextColor="{StaticResource Gray500}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="2" Text="Nilai" FontSize="11" FontAttributes="Bold" BackgroundColor="{StaticResource PrimaryLight}" TextColor="White" 
                                        HeightRequest="30" Padding="10,0" CornerRadius="6" Clicked="OnGradeStudentClicked" CommandParameter="Rizky Ramadhan" />
                            </Grid>
                        </Border>

                        <!-- Item Siswa 2 -->
                        <Border StrokeShape="RoundRectangle 12" BackgroundColor="#F8FAFC" Stroke="{StaticResource BorderLight}" Padding="12">
                            <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                <Border StrokeShape="RoundRectangle 20" BackgroundColor="#059669" WidthRequest="40" HeightRequest="40">
                                    <Label Text="NA" TextColor="White" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Nabila Az-Zahra" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Gray900}" />
                                    <Label Text="XII RPL 1 • Hadir (07:50 WIB)" FontSize="11" TextColor="{StaticResource Success}" />
                                    <Label Text="Jurnal Hari Ini: Menunggu" FontSize="10" TextColor="{StaticResource Warning}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="2" Text="Nilai" FontSize="11" FontAttributes="Bold" BackgroundColor="{StaticResource PrimaryLight}" TextColor="White" 
                                        HeightRequest="30" Padding="10,0" CornerRadius="6" Clicked="OnGradeStudentClicked" CommandParameter="Nabila Az-Zahra" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- ======================================================== -->
            <!-- VIEW 3: ROLE PEMBIMBING SEKOLAH (Guru Pembimbing)         -->
            <!-- ======================================================== -->
            <VerticalStackLayout x:Name="LayoutSekolahView" Spacing="16" IsVisible="False">
                <!-- Ringkasan Kehadiran Seluruh Siswa Binaan -->
                <Border StrokeShape="RoundRectangle 16" Stroke="{StaticResource BorderLight}" StrokeThickness="1" 
                        BackgroundColor="White" Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Monitoring Siswa Binaan Seluruh Mitra" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource PrimaryDark}" />
                        
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <Border StrokeShape="RoundRectangle 10" BackgroundColor="#EFF6FF" Padding="10">
                                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                    <Label Text="Total Binaan" FontSize="10" TextColor="{StaticResource Gray600}" />
                                    <Label Text="18 Siswa" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" StrokeShape="RoundRectangle 10" BackgroundColor="#DCFCE7" Padding="10">
                                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                    <Label Text="Hadir Hari Ini" FontSize="10" TextColor="#15803D" />
                                    <Label Text="17 Siswa" FontSize="14" FontAttributes="Bold" TextColor="#16A34A" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="2" StrokeShape="RoundRectangle 10" BackgroundColor="#FEF3C7" Padding="10">
                                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                    <Label Text="Izin / Sakit" FontSize="10" TextColor="#92400E" />
                                    <Label Text="1 Siswa" FontSize="14" FontAttributes="Bold" TextColor="#D97706" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Siswa Memerlukan Perhatian (Alert Geofence / Alpha) -->
                <Border StrokeShape="RoundRectangle 16" BackgroundColor="#F8FAFC" Stroke="{StaticResource BorderLight}" Padding="14">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Status Khusus Hari Ini" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Gray800}" />
                        <Border StrokeShape="RoundRectangle 10" BackgroundColor="#FFFBEB" Stroke="#FDE68A" Padding="10">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Text="ℹ️" FontSize="18" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Dimas Arya Pratama (PT Telkom)" FontSize="12" FontAttributes="Bold" TextColor="#92400E" />
                                    <Label Text="Status: Izin Resmi LKS Tingkat Provinsi (Disetujui Sekolah)" FontSize="11" TextColor="#78350F" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- ======================================================== -->
            <!-- VIEW 4: ROLE MONITOR (Koordinator Lapangan & BKK)         -->
            <!-- ======================================================== -->
            <VerticalStackLayout x:Name="LayoutMonitorView" Spacing="16" IsVisible="False">
                <Border StrokeShape="RoundRectangle 16" BackgroundColor="#FFFBEB" Stroke="#FDE68A" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Inspeksi Kunjungan DU/DI Mitra" FontSize="14" FontAttributes="Bold" TextColor="#92400E" />
                        <Label Text="Jadwal verifikasi fasilitas dan konfirmasi kepuasan industri terhadap kinerja siswa." FontSize="11" TextColor="#78350F" />
                        
                        <Button Text="+ Buat Laporan Monitoring Baru" FontSize="12" FontAttributes="Bold" 
                                BackgroundColor="#D97706" TextColor="White" HeightRequest="38" CornerRadius="8"
                                Clicked="OnNewMonitoringVisitClicked" />
                    </VerticalStackLayout>
                </Border>

                <!-- Riwayat Kunjungan Monitoring -->
                <Border StrokeShape="RoundRectangle 16" Stroke="{StaticResource BorderLight}" StrokeThickness="1" BackgroundColor="White" Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Riwayat Kunjungan Lapangan Terakhir" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource PrimaryDark}" />
                        <Border StrokeShape="RoundRectangle 10" BackgroundColor="#F8FAFC" Stroke="{StaticResource BorderLight}" Padding="12">
                            <VerticalStackLayout Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="PT Solusi Digital Nusantara" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Gray900}" />
                                    <Label Grid.Column="1" Text="Rating: 4.9 ★" FontSize="11" FontAttributes="Bold" TextColor="#D97706" />
                                </Grid>
                                <Label Text="Kunjungan tanggal 12 Okt 2026 • 2 Siswa Magang" FontSize="11" TextColor="{StaticResource Gray500}" />
                                <Label Text="Hasil: Lingkungan kerja sangat kondusif, mentor aktif membimbing framework web &amp; mobile." FontSize="11" TextColor="{StaticResource Gray700}" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- ======================================================== -->
            <!-- VIEW 5: ROLE ADMIN (Administrator PKL Sekolah)           -->
            <!-- ======================================================== -->
            <VerticalStackLayout x:Name="LayoutAdminView" Spacing="16" IsVisible="False">
                <!-- Statistik Makro PKL -->
                <Border StrokeShape="RoundRectangle 16" Stroke="{StaticResource BorderLight}" StrokeThickness="1" BackgroundColor="White" Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Statistik Keseluruhan Program PKL 2026" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource PrimaryDark}" />
                        
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                            <Border StrokeShape="RoundRectangle 12" BackgroundColor="#EFF6FF" Padding="12">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Total Siswa PKL" FontSize="10" TextColor="{StaticResource Gray600}" />
                                    <Label Text="142 Siswa" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" StrokeShape="RoundRectangle 12" BackgroundColor="#DCFCE7" Padding="12">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Mitra DU/DI Aktif" FontSize="10" TextColor="#15803D" />
                                    <Label Text="28 Perusahaan" FontSize="16" FontAttributes="Bold" TextColor="#16A34A" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Row="1" StrokeShape="RoundRectangle 12" BackgroundColor="#FEF3C7" Padding="12">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Rata-rata Presensi" FontSize="10" TextColor="#92400E" />
                                    <Label Text="97.4%" FontSize="16" FontAttributes="Bold" TextColor="#D97706" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" StrokeShape="RoundRectangle 12" BackgroundColor="#F3E8FF" Padding="12">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Guru Pembimbing" FontSize="10" TextColor="#6B21A8" />
                                    <Label Text="12 Guru" FontSize="16" FontAttributes="Bold" TextColor="#7C3AED" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Tombol Tindakan Admin Cepat -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Text="📊 Export Rekap (Excel)" FontSize="12" FontAttributes="Bold" 
                            BackgroundColor="{StaticResource PrimaryLight}" TextColor="White" HeightRequest="44" CornerRadius="10"
                            Clicked="OnExportDataClicked" />
                    <Button Grid.Column="1" Text="📢 Broadcast Pengumuman" FontSize="12" FontAttributes="Bold" 
                            BackgroundColor="{StaticResource PrimaryDark}" TextColor="White" HeightRequest="44" CornerRadius="10"
                            Clicked="OnBroadcastClicked" />
                </Grid>
            </VerticalStackLayout>

            <BoxView HeightRequest="20" Color="Transparent" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
